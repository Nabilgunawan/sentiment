# ============================================================
# KONFIGURASI - Advanced Indonesian Sentiment Analysis Platform
# Salin file ini menjadi .env dan sesuaikan
# ============================================================

# ── DeepSeek API (untuk Executive Summary saja) ──
# Dapatkan di: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Device Configuration ──
# auto = deteksi otomatis (GPU jika tersedia)
# cuda = paksa GPU
# cpu  = paksa CPU
DEVICE=auto

# ── Model Configuration ──
# Pre-trained model dari HuggingFace (default: IndoBERT)
# SENTIMENT_MODEL_NAME=indobenchmark/indobert-base-p1
# EMOTION_MODEL_NAME=indobenchmark/indobert-base-p1
# SARCASM_MODEL_NAME=indobenchmark/indobert-base-p1

# ── Inference Configuration ──
# Set USE_TRANSFORMERS=false untuk memaksa fallback lokal (lexicon & regex) secara instan (hemat memory, CPU, dan waktu download)
# USE_TRANSFORMERS=true
# BATCH_SIZE=32
# MAX_SEQ_LENGTH=128

# ── Training Configuration ──
# TRAINING_EPOCHS=5
# TRAINING_BATCH_SIZE=16
# TRAINING_LEARNING_RATE=2e-5
# TRAINING_VALIDATION_SPLIT=0.2

# ── Topic Modeling ──
# TOPIC_MODEL_EMBEDDING=indobenchmark/indobert-base-p1
# TOPIC_MIN_TOPIC_SIZE=10

# ── Flask ──
# SECRET_KEY=ganti-dengan-random-string-panjang
# FLASK_DEBUG=true
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000

# ── Report ──
# REPORT_COMPANY_NAME=Pahamdata.com
# REPORT_LOGO_PATH=

# ── Logging ──
# LOG_LEVEL=INFO
