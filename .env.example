# ============================================================
# KONFIGURASI API - Salin file ini menjadi .env
# dan isi dengan API key Anda
# ============================================================

# DeepSeek API Key (utama)
# Dapatkan di: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Atau gunakan Google Gemini API Key (alternatif)
# Dapatkan di: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key

# Secret key untuk Flask session (opsional, akan digenerate otomatis)
# SECRET_KEY=ganti-dengan-random-string-panjang
